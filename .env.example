# ── Database ──────────────────────────────
# MySQL/PlanetScale connection details
DB_HOST=localhost
DB_PORT=3306
DB_NAME=doctor_rag_1
DB_USER=root
DB_PASSWORD=your_mysql_password

# ── Pinecone Vector DB ─────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=medrag-index-v2

# ── Gemini AI ─────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# ── OpenAI (optional fallback) ─────────────
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── App ────────────────────────────────────
FLASK_SECRET_KEY=change_this_to_a_long_random_string_in_production
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=50
JWT_SECRET=another_long_random_secret_min_32_chars

# ── Embedding ─────────────────────────────
# Using all-MiniLM-L6-v2 (384 dims) — matches Pinecone index dimension
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── RAG ────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K_RESULTS=5
MIN_CONFIDENCE_THRESHOLD=0.0
